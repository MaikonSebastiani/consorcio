{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consorcio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-23",
  // Igual ao saitama-crm: só funciona pelos domínios próprios, nunca por *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.css", "**/ui.js"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consorcio-leads",
      // Preencher com o ID gerado por `npm run banco:criar` na publicação.
      "database_id": "bf2fbe5a-8663-402a-b641-91ba0aaf6e53",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMITE_LEADS", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "CRM_HOST": "consorcio.gruposaitama.com.br",
    // Aplicativo do Cloudflare Access "consorcio.gruposaitama.com.br" (só libera o e-mail do Maikon).
    "ACCESS_TEAM_DOMAIN": "plain-grass-964d.cloudflareaccess.com",
    "ACCESS_AUD": "6211b5b205d7b8931a40924f61c377f29ceaf62c67b0c8356f41ab63fa91842f",
    // Parcela reduzida em relação à cheia (cerca de 60% nos posts de 2026). Só o CRM usa; o site nunca mostra.
    "FATOR_PARCELA_REDUZIDA": "0.6"
  },
  "routes": [
    { "pattern": "gruposaitama.com.br", "custom_domain": true },
    { "pattern": "consorcio.gruposaitama.com.br", "custom_domain": true }
  ]
}
